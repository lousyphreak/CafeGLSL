#version 430
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) writeonly buffer Output {
   uint values[1024];
};
void main()
{
   uvec3 size = gl_NumWorkGroups * gl_WorkGroupSize;
   uint i = gl_GlobalInvocationID.x + size.x *
      (gl_GlobalInvocationID.y + size.y * gl_GlobalInvocationID.z);
   uint group = gl_WorkGroupID.x + gl_NumWorkGroups.x *
      (gl_WorkGroupID.y + gl_NumWorkGroups.y * gl_WorkGroupID.z);
   values[i] = gl_LocalInvocationIndex + 64u * group + 65536u * gl_NumWorkGroups.z;
}
